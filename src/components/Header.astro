---
/** App header shared by every page: wordmark, main navigation, search, settings. */
interface Props {
  current?: 'home' | 'categories' | 'sources' | 'saved';
}

const { current = 'home' } = Astro.props;

// Only Home exists so far; the other routes are planned.
const nav = [
  { id: 'home', label: 'Home', href: '/' },
  { id: 'categories', label: 'Categories', href: '/categories' },
  { id: 'sources', label: 'Sources', href: '/sources' },
  { id: 'saved', label: 'Saved', href: '/saved' }
] as const;
---

<header class="sticky top-0 z-20 border-b border-line bg-surface-raised">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-4 px-4 sm:gap-8 sm:px-8">
    <a href="/" class="font-display text-[21px] leading-none font-bold tracking-[-0.02em] text-ink no-underline">
      NoMo<span class="text-tide">FOMO</span>
    </a>

    <nav aria-label="Main" class="hidden gap-1 min-[560px]:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={item.id === current ? 'page' : undefined}
            class="rounded-md px-3 py-1.5 font-display text-sm font-semibold text-ink-muted no-underline hover:bg-surface hover:text-ink aria-[current=page]:bg-tide-soft aria-[current=page]:text-tide"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
