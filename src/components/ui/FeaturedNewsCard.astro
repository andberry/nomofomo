---
/**
 * FeaturedNewsCard — one news item in the homepage Featured grid.
 * With `image` the photo fills the 16:6 media strip; without, the strip stays
 * white and shows the source-type glyph.
 */
import type { SourceType } from "../../lib/design";
import { formatItemTime } from "../../lib/format";
import Avatar from "./Avatar.astro";
import Chip from "./Chip.astro";
import SourceGlyph from "./SourceGlyph.astro";

export interface Props {
  href: string;
  category: string;
  title: string;
  excerpt?: string;
  source: string;
  sourceType: SourceType;
  /** A Date is formatted per the brand book; a string is shown as given. */
  time: Date | string;
  image?: { src: string; alt: string };
  class?: string;
}

const {
  href,
  category,
  title,
  excerpt,
  source,
  sourceType,
  time,
  image,
  class: className,
} = Astro.props;

const timeLabel = typeof time === "string" ? time : formatItemTime(time);
const isoTime = typeof time === "string" ? undefined : time.toISOString();
---

<a
  href={href}
  class:list={[
    "group relative flex min-w-0 flex-col overflow-hidden rounded border border-gray bg-white text-black no-underline",
    "transition-colors duration-150 ease-out hover:border-black motion-reduce:transition-none",
    className,
  ]}
>
  <div class="relative grid aspect-16/6 place-items-center overflow-hidden border-b border-black">
    {/* glyph shows through if the image fails to load */}
    <SourceGlyph type={sourceType} class="size-10" />
    {image && (
      <img
        src={image.src}
        alt={image.alt}
        loading="lazy"
        decoding="async"
        class="absolute inset-0 size-full object-cover"
        onerror="this.remove()"
      />
    )}
    <div class="absolute right-3 bottom-3">
      <Chip>{category}</Chip>
    </div>
  </div>

  <div class="flex min-w-0 flex-1 flex-col gap-2 p-4">
    <h3 class="m-0 line-clamp-3 text-h4 leading-[1.2] text-balance text-black">
      {title}
    </h3>

    {excerpt && <p class="m-0 line-clamp-2 text-body-sm">{excerpt}</p>}

    {/* meta: source on the first line, "type · time" under it; pinned to the bottom edge */}
    <div class="mt-auto grid grid-cols-[20px_minmax(0,1fr)] items-center gap-x-2 gap-y-0.5 pt-2 text-meta tabular-nums">
      <Avatar name={source} />
      <span class="truncate font-semibold">{source}</span>
      <span class="col-start-2">
        {sourceType}
        <span aria-hidden="true" class="mx-1">
          ·
        </span>
        <time datetime={isoTime}>{timeLabel}</time>
      </span>
    </div>
  </div>
</a>
