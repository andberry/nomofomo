---
/** Source avatar: the source's initial on an ink disc. */
import { initial } from '../../lib/format';

interface Props {
  name: string;
  class?: string;
}
const { name, class: className } = Astro.props;
---

<span
  class:list={[
    'inline-grid size-5 flex-none place-items-center rounded-full bg-ink font-display text-[10px] leading-none font-bold text-surface-raised',
    className
  ]}
  aria-hidden="true">{initial(name)}</span
>
