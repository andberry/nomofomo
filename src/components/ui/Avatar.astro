---
/** Source avatar: the source's initial on a black disc. */
import { initial } from "../../lib/format";

interface Props {
  name: string;
  class?: string;
}
const { name, class: className } = Astro.props;
---

<span
  class:list={[
    "inline-grid size-5 flex-none place-items-center rounded-full bg-black-0 text-[10px] leading-none font-bold text-white",
    className,
  ]}
  aria-hidden="true"
>
  {initial(name)}
</span>
