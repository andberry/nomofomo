---
/**
 * CategoryCard — one category in the homepage Categories grid.
 * Shows new-item count (or "Caught up"), the latest headline, and its sources.
 */
import Avatar from './Avatar.astro';

export interface Props {
  href: string;
  name: string;
  newCount: number;
  latestTitle?: string;
  /** Source names; the first three show as stacked avatars. */
  sources: string[];
  class?: string;
}

const { href, name, newCount, latestTitle, sources, class: className } = Astro.props;
const shown = sources.slice(0, 3);
---

<a
  href={href}
  class:list={[
    'flex min-w-0 flex-col gap-3 rounded border border-black bg-white px-6 pt-6 pb-4 text-black no-underline',
    'transition-colors duration-150 ease-out hover:border-primary motion-reduce:transition-none',
    className
  ]}
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="m-0 text-h4">{name}</h3>
    {
      newCount > 0 ? (
        <span class="inline-flex flex-none items-center rounded-full bg-secondary px-2.5 py-1 text-xs leading-4 font-bold text-black tabular-nums">
          {newCount} new
        </span>
      ) : (
        <span class="inline-flex flex-none items-center gap-1.5 rounded-full border border-black px-2.25 py-0.75 text-xs leading-4 font-semibold">
          <svg class="size-3 text-primary" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2.5 6.5l2.2 2.2 4.8-5" />
          </svg>
          Caught up
        </span>
      )
    }
  </div>

  {
    latestTitle && (
      <p class="m-0 line-clamp-2 text-body-sm">
        <span class="mb-0.5 block text-label-sm text-primary uppercase">Latest</span>
        {latestTitle}
      </p>
    )
  }

  <div class="mt-auto flex items-center gap-2 text-meta tabular-nums">
    <span class="flex">
      {shown.map((s, i) => <Avatar name={s} class:list={['outline-2 outline-white', i > 0 && '-ml-0.75']} />)}
    </span>
    <span>{sources.length} {sources.length === 1 ? 'source' : 'sources'}</span>
  </div>
</a>
