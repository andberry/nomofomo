---
/** Category chip: black uppercase label on white with a black line. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center self-start rounded border border-black bg-white px-2 py-1 text-label-sm text-black uppercase',
    className
  ]}><slot /></span
>
