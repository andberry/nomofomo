---
/** Living style guide: tokens and components of the NoMoFOMO design system. */
import Base from '../layouts/Base.astro';
import CategoryCard from '../components/ui/CategoryCard.astro';
import FeaturedNewsCard from '../components/ui/FeaturedNewsCard.astro';

const now = Date.now();
const minsAgo = (m: number) => new Date(now - m * 60_000);

const colours = [
  ['white', 'bg-white', 'Page and every surface'],
  ['black', 'bg-black', 'Text, headings, icons and lines'],
  ['primary', 'bg-primary', 'Actions, links, active nav, focus'],
  ['secondary', 'bg-secondary', 'Unread only: dots and counters']
];
const type = [
  ['h1', 'text-h1', 'Featured stories worth your time'],
  ['h2', 'text-h2', 'Featured'],
  ['h3', 'text-h3', 'Europe agrees on a common AI audit standard'],
  ['h4', 'text-h4', 'Technology'],
  ['body', 'text-body', 'Regulators published the final text on Tuesday, after eighteen months of negotiation.'],
  ['body-sm', 'text-body-sm', 'Two-line excerpt under a card headline, clipped with an ellipsis.'],
  ['label', 'text-label uppercase', 'Technology'],
  ['label-sm', 'text-label-sm uppercase', 'Newsletter'],
  ['meta', 'text-meta tabular-nums', 'The Verge · Article · 14 min ago']
];
---

<Base title="Style guide · NoMoFOMO">
  <main class="mx-auto flex max-w-[1280px] flex-col gap-12 px-4 py-12 sm:px-8">
    <header class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="m-0 mb-2 text-label uppercase">Design system</p>
        <h1 class="m-0 text-h1">NoMo<span class="text-primary">FOMO</span> style guide</h1>
      </div>
    </header>

    <section class="flex flex-col gap-6">
      <h2 class="m-0 text-h2">Colours</h2>
      <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
        {
          colours.map(([name, cls, usage]) => (
            <div class="flex flex-col gap-2">
              <div class:list={['h-16 rounded border border-black', cls]} />
              <code class="text-meta font-semibold">{name}</code>
              <span class="text-meta">{usage}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="flex flex-col gap-6">
      <h2 class="m-0 text-h2">Typography</h2>
      <div class="flex flex-col divide-y divide-black rounded border border-black bg-white">
        {
          type.map(([name, cls, sample]) => (
            <div class="grid gap-2 p-4 sm:grid-cols-[120px_1fr] sm:items-baseline">
              <code class="text-meta">text-{name}</code>
              <p class:list={['m-0', cls]}>{sample}</p>
            </div>
          ))
        }
      </div>
      <p class="m-0 text-meta">Geist only, weights 400–700. One radius (<code>rounded</code>, 8px). No shadows.</p>
    </section>

    <section class="flex flex-col gap-6">
      <h2 class="m-0 text-h2">FeaturedNewsCard</h2>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        <FeaturedNewsCard
          href="#"
          category="Technology"
          title="Why chip makers are moving packaging back to Europe"
          excerpt="Three plants announced this quarter point to a shift in where the last, most valuable step of production happens."
          source="The Verge"
          sourceType="Article"
          time={minsAgo(14)}
          image={{ src: '/mocks/wafer-macro.jpg', alt: 'Rainbow reflections on a patterned silicon wafer' }}
        />
        <FeaturedNewsCard
          href="#"
          category="Science"
          title="How the new ocean heat maps were made, explained by the team"
          excerpt="A walkthrough of the satellite data and ten years of buoy readings behind it."
          source="Kurzgesagt"
          sourceType="Video"
          time={minsAgo(120)}
          image={{ src: '/mocks/ocean-waves.jpg', alt: 'Aerial view of waves breaking on a beach' }}
        />
        <FeaturedNewsCard
          href="#"
          category="Business"
          title="The quiet return of the four-day week in mid-sized companies"
          excerpt="This week's issue looks at payroll data from 400 firms and what changed after the pilots ended."
          source="Morning Brew"
          sourceType="Newsletter"
          time={minsAgo(150)}
        />
        <FeaturedNewsCard
          href="#"
          category="World"
          title="Europe agrees on a common AI audit standard"
          excerpt="The final text sets out who checks high-risk systems and how often."
          source="Corriere della Sera"
          sourceType="Newspaper"
          time={minsAgo(26 * 60)}
          image={{ src: '/mocks/eu-parliament.jpg', alt: 'The European Parliament chamber in Brussels' }}
        />
      </div>
    </section>

    <section class="flex flex-col gap-6">
      <h2 class="m-0 text-h2">CategoryCard</h2>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <CategoryCard href="#" name="Technology" newCount={5} latestTitle="Why chip makers are moving packaging back to Europe" sources={['The Verge', 'Simon Willison', 'Ars Technica', 'Wired', 'Hacker News', 'Platformer', 'Stratechery', 'Ben Thompson', 'Lobsters']} />
        <CategoryCard href="#" name="Design" newCount={2} latestTitle="A type foundry open-sources its newsroom family" sources={['Design Notes', 'It’s Nice That', 'Eye on Design']} />
        <CategoryCard href="#" name="Sport" newCount={0} latestTitle="What the new calendar means for the Champions League group stage" sources={['BBC Sport', 'The Athletic']} />
      </div>
    </section>

    <p class="m-0 text-meta">Sample photos: Wikimedia Commons (see public/mocks/CREDITS.md).</p>
  </main>

</Base>
